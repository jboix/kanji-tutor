{
  "name": "@kanji-tutor/web",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "The Kanji Tutor PWA: React, Dexie and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts tests/e2e/navigation.spec.ts tests/e2e/reading.spec.ts tests/e2e/a11y.spec.ts tests/e2e/a11y-states.spec.ts",
    "test:iphone": "PW_WEBKIT=1 playwright test --project iphone-webkit",
    "arch:fixture": "bun scripts/arch-fixture.ts",
    "packs": "bun scripts/packs/build.ts",
    "packs:measure": "bun scripts/packs/measure-sentences.ts",
    "credits": "bun scripts/credits.ts",
    "social": "SOCIAL=1 playwright test tests/e2e/social-shot.spec.ts --project phone-390 && bun scripts/social-preview.ts",
    "size": "bun scripts/bundle-size.ts",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots --project phone-390 --workers 2"
  },
  "dependencies": {
    "@fontsource/klee-one": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@google/genai": "^2.30.0",
    "@simplewebauthn/browser": "^14.0.0",
    "dexie": "^4.4.0",
    "kuromoji": "^0.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "ts-fsrs": "^5.4.0",
    "wanakana": "^5.3.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/kuromoji": "^0.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
