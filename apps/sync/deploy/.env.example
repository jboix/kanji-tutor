# Copy to .env on the server and fill in. Never commit .env: SAVE_KEY decrypts every save.

# The domain pointing at this server (A and AAAA records), for HTTPS.
SYNC_DOMAIN=api.example.com

# The app's origin: the only one allowed to call.
APP_ORIGIN=https://app.example.com
# Optional. Where the app lives, for invite links; by default the origin's root.
APP_URL=https://app.example.com/
# Optional. The passkeys' domain: the app's host name (the default) or a domain above it.
# Never change it once accounts exist: their passkeys stop working.
RP_ID=example.com

# 32 random bytes, base64: run `openssl rand -base64 32` once, and keep a copy safe.
SAVE_KEY=

# Written by deploy.sh: the commit whose image runs. SYNC_IMAGE overrides the image's name.
SYNC_TAG=

# Optional, for email codes (sign-in on a new device, recovery), over any SMTP server.
# Leave SMTP_HOST empty to keep email off. Port 465 is TLS; any other port requires STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
