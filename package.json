{
  "name": "kanji-reader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal, phone-first PWA for reading Japanese kanji in context (N3).",
  "license": "MIT",
  "homepage": "https://jboix.github.io/kanji-reader/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/kanji-reader.git"
  },
  "bugs": {
    "url": "https://github.com/jboix/kanji-reader/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "arch:fixture": "bun scripts/arch-fixture.ts",
    "knip": "knip",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:iphone": "PW_WEBKIT=1 playwright test --project iphone-webkit",
    "docs:check": "remark . --quiet --frail --ignore-path .remarkignore",
    "docs:format": "remark . --quiet --output --ignore-path .remarkignore",
    "packs": "bun scripts/packs/build.ts",
    "packs:measure": "bun scripts/packs/measure-sentences.ts",
    "credits": "bun scripts/credits.ts",
    "social": "SOCIAL=1 playwright test tests/e2e/social-shot.spec.ts --project phone-390 && bun scripts/social-preview.ts",
    "check": "bun run typecheck && bun run lint && bun run docs:check && bun run arch && bun run arch:fixture && bun run knip && bun run test && bun run build && bun run size",
    "prepare": "husky",
    "size": "bun scripts/bundle-size.ts",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots --project phone-390 --workers 2"
  },
  "dependencies": {
    "@fontsource/klee-one": "^5.3.1",
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@google/genai": "^2.30.0",
    "dexie": "^4.4.0",
    "kuromoji": "^0.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "ts-fsrs": "^5.4.0",
    "wanakana": "^5.3.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "@semantic-release/git": "^11.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/kuromoji": "^0.1.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
