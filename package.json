{
  "name": "kanji-tutor",
  "private": true,
  "type": "module",
  "description": "Personal, phone-first PWA for reading Japanese kanji in context (N3).",
  "license": "MIT",
  "homepage": "https://app.kanjitutor.ch/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jboix/kanji-tutor.git"
  },
  "bugs": {
    "url": "https://github.com/jboix/kanji-tutor/issues"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "arch": "depcruise apps --config .dependency-cruiser.cjs",
    "arch:fixture": "bun run --cwd apps/web arch:fixture",
    "knip": "knip",
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:smoke": "bun run --cwd apps/web test:e2e:smoke",
    "test:iphone": "bun run --cwd apps/web test:iphone",
    "docs:check": "remark . --quiet --frail --ignore-path .remarkignore",
    "docs:format": "remark . --quiet --output --ignore-path .remarkignore",
    "packs": "bun run --cwd apps/web packs",
    "packs:measure": "bun run --cwd apps/web packs:measure",
    "credits": "bun run --cwd apps/web credits",
    "social": "bun run --cwd apps/web social",
    "size": "bun run --cwd apps/web size",
    "screenshots": "bun run --cwd apps/web screenshots",
    "sync:dev": "bun run --cwd apps/sync dev",
    "sync:build": "bun run --cwd apps/sync build",
    "check": "bun run typecheck && bun run lint && bun run docs:check && bun run arch && bun run arch:fixture && bun run knip && bun run test && bun run build && bun run size && bun run sync:build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/git": "^11.0.1",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "knip": "^6.42.1",
    "remark-cli": "^12.0.1",
    "remark-gfm": "^4.0.1",
    "remark-validate-links": "^13.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "~6.0.3"
  }
}
