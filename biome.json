{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!**/dist",
      "!**/dev-dist",
      "!**/coverage",
      "!apps/web/public/packs",
      "!notes"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "css": { "parser": { "cssModules": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 8 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 25, "skipBlankLines": true }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "noUndeclaredDependencies": "error"
      },
      "suspicious": { "noExplicitAny": "error", "noConsole": "error" },
      "style": {
        "noExcessiveLinesPerFile": { "level": "error", "options": { "maxLines": 400 } },
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noDefaultExport": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] }
        },
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "Function": "No model-written code runs; build the value without evaluating code.",
              "eval": "No model-written code runs; build the value without evaluating code."
            }
          }
        }
      },
      "security": { "noDangerouslySetInnerHtml": "error", "noGlobalEval": "error" },
      "nursery": { "noImpliedEval": "error" }
    },
    "domains": { "react": "recommended" }
  },
  "overrides": [
    {
      "includes": ["**/*.config.ts", "**/*.config.js", "**/*.config.mjs", ".remarkrc.mjs"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "apps/web/tests/**",
        "apps/*/scripts/**",
        "apps/web/src/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          },
          "style": { "noExcessiveLinesPerFile": "off", "noNonNullAssertion": "off" }
        }
      }
    },
    {
      "includes": ["apps/*/scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
