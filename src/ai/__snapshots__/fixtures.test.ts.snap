[
  {
    "answer": "間に marks a point inside a stretch of time: the reading happened at some point while you were waiting. Without に, 間 covers the whole stretch, so the verb usually describes an ongoing state, like 読んでいた.",
    "readings": [
      {
        "reading": "あいだ",
        "surface": "間",
        "verified": true,
      },
      {
        "reading": "よんでいた",
        "surface": "読んでいた",
        "verified": true,
      },
    ],
  },
  {
    "answer": ""However, it isn't that fewer people speak dialects." The writer is pushing back on the previous line. That's the job わけではない does, and it's this week's grammar.",
    "readings": [
      {
        "reading": "ほうげん",
        "surface": "方言",
        "verified": true,
      },
      {
        "reading": "はなす",
        "surface": "話す",
        "verified": false,
      },
      {
        "reading": "へっている",
        "surface": "減っている",
        "verified": false,
      },
    ],
  },
]
`;

